root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

[*.{json,yaml,yml,toml}]
indent_size = 2

[*.rs]
indent_size = 4

[*.{py,sh}]
indent_size = 4
