{
  "cases": [
    {
      "name": "filter_gte",
      "sql": "SELECT * FROM t WHERE x >= 2",
      "expect": [{ "x": 2 }, { "x": 3 }]
    },
    {
      "name": "in_list",
      "sql": "SELECT x FROM t WHERE x IN (1, 3)",
      "expect": [{ "x": 1 }, { "x": 3 }]
    },
    {
      "name": "distinct",
      "sql": "SELECT DISTINCT x FROM t",
      "expect": [{ "x": 1 }, { "x": 2 }, { "x": 3 }]
    },
    {
      "name": "count",
      "sql": "SELECT COUNT(*) FROM t",
      "expect": [{ "count": 3 }]
    },
    {
      "name": "typed_rows",
      "sql": "SELECT f, s, b, n FROM typed ORDER BY f",
      "expect": [
        { "f": 1.5, "s": "uno", "b": false, "n": null },
        { "f": 2.0, "s": "dos", "b": true, "n": null }
      ]
    },
    {
      "name": "float_projection",
      "sql": "SELECT f FROM typed ORDER BY f",
      "expect": [{ "f": 1.5 }, { "f": 2.0 }]
    },
    {
      "name": "missing_column",
      "sql": "SELECT nope FROM t",
      "expect_error": true
    }
  ]
}
